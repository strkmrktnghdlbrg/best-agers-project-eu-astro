---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
import { imageFor } from "../data/images";

interface Props {
  title: string;
  description: string;
  /** Rechtsseiten und Duplikate aus dem Index halten. */
  noindex?: boolean;
  /** Kanonischer Pfad, z.B. "/mittel/heilerde/". Default: aktuelle URL. */
  canonicalPath?: string;
  /** Optionales JSON-LD (Objekt oder Array). */
  schema?: unknown;
  /** Ads unterdruecken – fuer duenne Seiten und den spaeteren Produktbaum. */
  noAds?: boolean;
}

const {
  title,
  description,
  noindex = false,
  canonicalPath,
  schema,
  noAds = false,
} = Astro.props;

// AdSense nur auf indexierbaren Seiten mit Substanz. noindex impliziert noAds:
// Rechtsseiten, 404 und /go/ bekommen kein Snippet.
const showAds = Boolean(site.adsenseClient) && !noindex && !noAds;

const canonical = new URL(canonicalPath ?? Astro.url.pathname, site.url).href;
const fullTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;

// OG-Bild aus der generierten Zuordnung, sonst kein Bild-Tag. Absolute URL
// ist Pflicht, relative Pfade werden von den meisten Netzwerken ignoriert.
const ogImg = imageFor(canonicalPath ?? Astro.url.pathname);
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="de_DE" />
    {
      ogImg && (
        <>
          <meta property="og:image" content={new URL(ogImg.src, site.url).href} />
          <meta property="og:image:width" content={String(ogImg.width)} />
          <meta property="og:image:height" content={String(ogImg.height)} />
          <meta property="og:image:alt" content={ogImg.alt} />
        </>
      )
    }
    <meta name="twitter:card" content={ogImg ? "summary_large_image" : "summary"} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {
      schema && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(schema)}
        />
      )
    }

    {/* Google AdSense (Auto Ads), ungated. Nicht auf noindex-Seiten. */}
    {
      showAds && (
        <script
          async
          is:inline
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${site.adsenseClient}`}
          crossorigin="anonymous"
        />
      )
    }

    {/* Google Tag Manager – ungated, kein Consent-Gate (Portfolio-Standard).
        GA4 laeuft ueber das Config-Tag IM Container, nicht separat hier. */}
    {
      site.gtmId && (
        <script is:inline define:vars={{ gtmId: site.gtmId }}>
          {/* ACHTUNG: Der Script-Inhalt ist Rohtext, KEIN Astro-Ausdruck.
              Ein `{`...`}` drumherum landet woertlich im Output und wird dort
              zu einem JS-Block mit einem Template-Literal, das nur ausgewertet
              und verworfen wird – GTM laedt dann nie. Deshalb hier nacktes JS. */}
          (function (w, d, s, l, i) {
            w[l] = w[l] || [];
            w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
            var f = d.getElementsByTagName(s)[0],
              j = d.createElement(s),
              dl = l != "dataLayer" ? "&l=" + l : "";
            j.async = true;
            j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
            f.parentNode.insertBefore(j, f);
          })(window, document, "script", "dataLayer", gtmId);
        </script>
      )
    }
  </head>
  <body>
    {
      site.gtmId && (
        <noscript>
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=${site.gtmId}`}
            height="0"
            width="0"
            style="display:none;visibility:hidden"
            title="Google Tag Manager"
          />
        </noscript>
      )
    }
    <a
      href="#inhalt"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-3 focus:rounded-lg focus:bg-ink focus:px-4 focus:py-2 focus:text-white"
      >Zum Inhalt springen</a
    >
    <Header />
    <main id="inhalt">
      <slot />
    </main>
    <Footer />
  </body>
</html>
