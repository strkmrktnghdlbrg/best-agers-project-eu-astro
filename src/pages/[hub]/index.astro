---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import FaqBlock from "../../components/FaqBlock.astro";
import RelatedLinks from "../../components/RelatedLinks.astro";
import PartnerSlot from "../../components/PartnerSlot.astro";
import { hubs, livePages, pageUrl } from "../../data/taxonomy";
import { site } from "../../data/site";

export async function getStaticPaths() {
  const entries = await getCollection("hubs");
  return hubs.map((hub) => ({
    params: { hub: hub.slug },
    props: { hub, entry: entries.find((e) => e.data.hub === hub.slug) },
  }));
}

const { hub, entry } = Astro.props;
const pages = livePages(hub);
const Content = entry ? (await render(entry)).Content : null;

const canonicalPath = `/${hub.slug}/`;
const description = hub.claim.slice(0, 158);

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: hub.title,
    description,
    url: new URL(canonicalPath, site.url).href,
    inLanguage: "de",
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Start",
        item: new URL("/", site.url).href,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: hub.name,
        item: new URL(canonicalPath, site.url).href,
      },
    ],
  },
  ...(entry && entry.data.faq.length
    ? [
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          mainEntity: entry.data.faq.map((f) => ({
            "@type": "Question",
            name: f.q,
            acceptedAnswer: { "@type": "Answer", text: f.a },
          })),
        },
      ]
    : []),
];
---

<BaseLayout
  title={hub.title}
  description={description}
  canonicalPath={canonicalPath}
  schema={schema}
>
  <div class="container-wide pt-6">
    <Breadcrumbs items={[{ label: hub.name }]} />
  </div>

  <header class="container-narrow pt-6">
    <h1 class="font-display text-3xl font-bold text-ink-900 sm:text-4xl">
      {hub.title}
    </h1>
    <p class="mt-4 text-lg leading-relaxed text-ink-600">
      {entry?.data.lead ?? hub.claim}
    </p>
    {
      entry && (
        <p class="mt-3 text-sm text-ink-400">
          Stand:{" "}
          {entry.data.updated.toLocaleDateString("de-DE", {
            day: "2-digit",
            month: "long",
            year: "numeric",
          })}
        </p>
      )
    }
  </header>

  <div class="container-narrow min-w-0">
    {
      Content && (
        <div class="prose-hx mt-8">
          <Content />
        </div>
      )
    }

    <PartnerSlot topic={hub.slug} query={hub.kw} />

    <section class="mt-12">
      <h2 class="font-display text-2xl font-bold text-ink-900">
        Alle Themen in {hub.name}
      </h2>
      <div class="mt-5 grid gap-4 sm:grid-cols-2">
        {
          pages.map((p) => (
            <a href={pageUrl(hub, p)} class="card card-link min-w-0">
              <h3 class="font-display text-base font-bold text-ink-900">
                {p.nav}
              </h3>
              <p class="mt-1.5 text-sm leading-relaxed text-ink-500">
                {p.title}
              </p>
            </a>
          ))
        }
      </div>
    </section>

    {entry && <FaqBlock items={entry.data.faq} />}

    {
      entry && entry.data.quellen.length > 0 && (
        <section class="mt-12 rounded-xl border border-ink-200 bg-ink-50 p-5">
          <h2 class="font-display text-base font-bold text-ink-900">Quellen</h2>
          <ul class="mt-2 flex flex-col gap-1.5 text-sm text-ink-500">
            {entry.data.quellen.map((q) => (
              <li>{q}</li>
            ))}
          </ul>
        </section>
      )
    }

    <RelatedLinks hub={hub} />
  </div>
</BaseLayout>
