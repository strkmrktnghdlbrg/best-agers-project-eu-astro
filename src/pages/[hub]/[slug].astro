---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import FaqBlock from "../../components/FaqBlock.astro";
import RelatedLinks from "../../components/RelatedLinks.astro";
import PartnerSlot from "../../components/PartnerSlot.astro";
import PageImage from "../../components/PageImage.astro";
import { hubs, livePages } from "../../data/taxonomy";
import { site } from "../../data/site";

export async function getStaticPaths() {
  const entries = await getCollection("artikel");
  return hubs.flatMap((hub) =>
    livePages(hub).map((page) => ({
      params: { hub: hub.slug, slug: page.slug },
      props: {
        hub,
        page,
        entry: entries.find(
          (e) => e.data.hub === hub.slug && e.data.pageSlug === page.slug
        ),
      },
    }))
  );
}

const { hub, page, entry } = Astro.props;
const Content = entry ? (await render(entry)).Content : null;

const canonicalPath = `/${hub.slug}/${page.slug}/`;
const description = (entry?.data.lead ?? page.title).slice(0, 158);

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: page.title,
    description,
    inLanguage: "de",
    mainEntityOfPage: new URL(canonicalPath, site.url).href,
    publisher: {
      "@type": "Organization",
      name: site.name,
      url: site.url,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Start",
        item: new URL("/", site.url).href,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: hub.name,
        item: new URL(`/${hub.slug}/`, site.url).href,
      },
      {
        "@type": "ListItem",
        position: 3,
        name: page.nav,
        item: new URL(canonicalPath, site.url).href,
      },
    ],
  },
  ...(entry && entry.data.faq.length
    ? [
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          mainEntity: entry.data.faq.map((f) => ({
            "@type": "Question",
            name: f.q,
            acceptedAnswer: { "@type": "Answer", text: f.a },
          })),
        },
      ]
    : []),
];
---

<BaseLayout
  title={page.title}
  description={description}
  canonicalPath={canonicalPath}
  schema={schema}
>
  <div class="container-narrow pt-8">
    <Breadcrumbs
      items={[{ label: hub.name, href: `/${hub.slug}/` }, { label: page.nav }]}
    />
  </div>

  <article class="container-narrow min-w-0 pt-6">
    <h1>{page.title}</h1>
    {
      entry && <p class="mt-4 text-lg">{entry.data.lead}</p>
    }

    {/* Bild nach Titel und Lead: der Text soll zuerst gelesen werden, das
        Foto ordnet ein und traegt keine Information. */}
    <PageImage path={canonicalPath} priority={true} class="mt-8" />

    {
      Content && (
        <div class="prose-hx mt-8">
          <Content />
        </div>
      )
    }

    <PartnerSlot topic={`${hub.slug}/${page.slug}`} query={page.kw} />

    {entry && <FaqBlock items={entry.data.faq} />}

    {
      entry && entry.data.quellen.length > 0 && (
        <section class="mt-12 rounded-lg border border-ink bg-warm p-5">
          <h2 class="font-display text-base font-bold text-ink">Quellen</h2>
          <ul class="mt-2 flex flex-col gap-1.5 text-sm text-ink">
            {entry.data.quellen.map((q) => (
              <li>{q}</li>
            ))}
          </ul>
        </section>
      )
    }

    <RelatedLinks hub={hub} current={page} />
  </article>
</BaseLayout>
