---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { hubs, livePages, pageUrl } from "../../data/taxonomy";
import { allLivePages } from "../../data/taxonomy";
---

<BaseLayout
  title="Ratgeber: alle Themen ab 50 im Überblick"
  description="Alle Ratgeber von Best Agers, sortiert nach Themenbereich: Rente, Altersvorsorge, Pflegegrad, barrierefreies Wohnen und Gesundheit ab 50."
  canonicalPath="/ratgeber/"
>
  <div class="container-wide pt-6">
    <Breadcrumbs items={[{ label: "Ratgeber" }]} />
  </div>

  <header class="container-narrow pt-6">
    <h1 class="font-display text-3xl font-bold text-ink-900 sm:text-4xl">
      Alle Ratgeber
    </h1>
    <p class="mt-4 text-lg leading-relaxed text-ink-600">
      {allLivePages.length} Beiträge in fünf Themenbereichen. Jeder Beitrag
      nennt die Beträge mit Stand und die Quelle, aus der sie stammen.
    </p>
  </header>

  <div class="container-wide py-12">
    {
      hubs.map((hub) => (
        <section class="mt-12 first:mt-0">
          <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-b border-ink-200 pb-3">
            <h2 class="font-display text-2xl font-bold text-ink-900">
              <a href={`/${hub.slug}/`} class="hover:text-azure-700">
                {hub.name}
              </a>
            </h2>
            <span class="text-sm text-ink-400">
              {livePages(hub).length} Beiträge
            </span>
          </div>
          <p class="mt-3 max-w-3xl text-ink-600">{hub.claim}</p>
          <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {livePages(hub).map((p) => (
              <li>
                <a href={pageUrl(hub, p)} class="card card-link block h-full min-w-0">
                  <span class="font-display text-base font-bold leading-snug text-ink-900">
                    {p.title}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>
