---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { hubs, livePages, pageUrl } from "../../data/taxonomy";
import { allLivePages } from "../../data/taxonomy";
import PageImage from "../../components/PageImage.astro";
import { imageFor } from "../../data/images";
---

<BaseLayout
  title="Ratgeber: alle Themen ab 50 im Überblick"
  description="Alle Ratgeber von Best Agers, sortiert nach Themenbereich: Rente, Altersvorsorge, Pflegegrad, barrierefreies Wohnen und Gesundheit ab 50."
  canonicalPath="/ratgeber/"
>
  <div class="container-wide pt-8">
    <Breadcrumbs items={[{ label: "Ratgeber" }]} />
  </div>

  <header class="container-wide pt-6">
    <h1 class="font-display text-3xl font-bold text-ink sm:text-4xl">
      Alle Ratgeber
    </h1>
    <p class="mt-4 text-lg leading-relaxed text-ink">
      {allLivePages.length} Beiträge in fünf Themenbereichen. Jeder Beitrag
      nennt die Beträge mit Stand und die Quelle, aus der sie stammen.
    </p>
    <PageImage path="/ratgeber/" priority={true} variant="banner" class="mt-8" />
  </header>

  <div class="container-wide py-12">
    {
      hubs.map((hub) => (
        <section class="mt-12 first:mt-0">
          <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-b border-ink pb-3">
            <h2 class="font-display text-2xl font-bold text-ink">
              <a href={`/${hub.slug}/`} class="hover:text-link">
                {hub.name}
              </a>
            </h2>
            <span class="text-sm text-ink">
              {livePages(hub).length} Beiträge
            </span>
          </div>
          <p class="mt-3 max-w-3xl text-ink">{hub.claim}</p>
          <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {livePages(hub).map((p) => (
              <li>
                <a href={pageUrl(hub, p)} class="card card-link block h-full min-w-0 !p-0">
                  {imageFor(pageUrl(hub, p)) && (
                    <img
                      src={imageFor(pageUrl(hub, p))!.srcCard}
                      width="600"
                      height="338"
                      alt=""
                      loading="lazy"
                      decoding="async"
                      class="aspect-video w-full rounded-t-lg border-b border-ink object-cover"
                    />
                  )}
                  <span class="block p-5 text-subheading font-bold leading-[1.2] tracking-[-0.027em]">
                    {p.title}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>
