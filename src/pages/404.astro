---
import BaseLayout from "../layouts/BaseLayout.astro";
import { hubs, livePages, allLivePages, pageUrl } from "../data/taxonomy";

/**
 * Top-404: verlinkt breit, damit Besucher aus alten Quellen nicht abspringen.
 * Die Domain trug bis 2012 eine DotNetNuke-Struktur (/BestAgers/.../tabid/...)
 * und danach eine WordPress-Installation. Die bekannten Muster fangen die
 * 301-Regeln in public/.htaccess ab; hier landet nur, was dort nicht passt.
 */
const top = allLivePages
  .slice()
  .sort((a, b) => b.vol * (1 + b.cpc) - a.vol * (1 + a.cpc))
  .slice(0, 10);
---

<BaseLayout
  title="Seite nicht gefunden"
  description="Die aufgerufene Seite gibt es nicht mehr. Hier finden Sie die Themenbereiche und die meistgelesenen Ratgeber von Best Agers."
  noindex={true}
>
  <div class="container-narrow py-14">
    <p class="font-display text-6xl font-bold text-azure-200">404</p>
    <h1 class="mt-3 font-display text-3xl font-bold text-ink-900 sm:text-4xl">
      Diese Seite gibt es nicht mehr
    </h1>
    <p class="mt-4 text-lg leading-relaxed text-ink-600">
      Der Link ist womöglich veraltet oder enthält einen Tippfehler. Über die
      Suche oder die Themenbereiche kommen Sie direkt weiter.
    </p>

    <form class="mt-8" role="search" action="/suche/" method="get">
      <label for="q404" class="sr-only">Suchbegriff</label>
      <div class="flex flex-col gap-3 sm:flex-row">
        <input
          type="search"
          id="q404"
          name="q"
          placeholder="Stichwort, etwa Pflegegrad oder Treppenlift"
          class="min-w-0 flex-1 rounded-full border border-ink-300 px-5 py-3 text-base text-ink-800 outline-none transition-colors focus:border-azure-500"
        />
        <button type="submit" class="btn btn-primary">Suchen</button>
      </div>
    </form>
  </div>

  <section class="border-y border-ink-200 bg-ink-50">
    <div class="container-wide py-12">
      <h2 class="font-display text-2xl font-bold text-ink-900">
        Die Themenbereiche
      </h2>
      <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          hubs.map((hub) => (
            <div class="card min-w-0">
              <h3 class="font-display text-lg font-bold text-ink-900">
                <a href={`/${hub.slug}/`} class="hover:text-azure-700">
                  {hub.name}
                </a>
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-500">
                {hub.teaser}
              </p>
              <ul class="mt-3 flex flex-col gap-1.5">
                {livePages(hub)
                  .slice(0, 4)
                  .map((p) => (
                    <li>
                      <a
                        href={pageUrl(hub, p)}
                        class="text-sm text-azure-700 underline decoration-azure-200 underline-offset-4 hover:decoration-azure-500"
                      >
                        {p.nav}
                      </a>
                    </li>
                  ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="container-wide py-12">
    <h2 class="font-display text-2xl font-bold text-ink-900">
      Die meistgelesenen Ratgeber
    </h2>
    <ul class="mt-6 grid gap-3 sm:grid-cols-2">
      {
        top.map((p) => (
          <li>
            <a
              href={`/${p.hub}/${p.slug}/`}
              class="block rounded-xl border border-ink-200 bg-white p-4 transition-colors hover:border-azure-300"
            >
              <span class="text-xs font-semibold uppercase tracking-wide text-azure-600">
                {p.hubName}
              </span>
              <span class="mt-1 block font-display text-base font-bold text-ink-900">
                {p.title}
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/" class="btn btn-primary">Zur Startseite</a>
      <a href="/ratgeber/" class="btn btn-outline">Alle Ratgeber</a>
      <a href="/kontakt/" class="btn btn-outline">Fehlenden Link melden</a>
    </div>
  </section>
</BaseLayout>
