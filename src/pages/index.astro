---
import BaseLayout from "../layouts/BaseLayout.astro";
import PartnerSlot from "../components/PartnerSlot.astro";
import ArrowIcon from "../components/ArrowIcon.astro";
import { hubs, livePages, pageUrl, allLivePages } from "../data/taxonomy";
import { site } from "../data/site";

/** Einstiegsseiten fuer die Startseite: die nachfragestaerksten je Hub. */
const einstiege = hubs.flatMap((hub) =>
  livePages(hub)
    .slice()
    .sort((a, b) => b.vol - a.vol)
    .slice(0, 2)
    .map((p) => ({ hub, p }))
);

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: site.name,
    url: site.url,
    inLanguage: "de",
    description: site.description,
    potentialAction: {
      "@type": "SearchAction",
      target: {
        "@type": "EntryPoint",
        urlTemplate: `${site.url}/suche/?q={search_term_string}`,
      },
      "query-input": "required name=search_term_string",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: site.name,
    url: site.url,
    description: site.description,
  },
];
---

<BaseLayout
  title="Best Agers: Rente, Pflege, Wohnen und Gesundheit ab 50"
  description={site.description}
  canonicalPath="/"
  schema={schema}
>
  {/* Hero als Zweiteilung: 2/3 Textflaeche, 1/3 gelbe Aktionsflaeche.
      Das ist die Signatur des Systems. Ohne Fotografie traegt hier die
      Typografie, was das Original mit Bildern macht. */}
  <section class="container-wide pt-8 pb-20">
    <div class="grid gap-6 lg:grid-cols-3">
      <div
        class="rounded-lg border border-ink bg-warm p-8 sm:p-12 lg:col-span-2"
      >
        <p class="kicker">{site.tagline}</p>
        <h1 class="mt-5">Die zweite Lebenshälfte gut organisiert</h1>
        <p class="mt-6 max-w-2xl text-lg">
          Rentenantrag, Pflegegrad, Treppenlift, Altersvorsorge: die Themen ab
          50 hängen an Fristen, Anträgen und Beträgen, die kaum jemand parat
          hat. Wir erklären sie mit aktuellen Zahlen und nennen die Quelle dazu.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/ratgeber/" class="btn btn-primary">Alle Ratgeber</a>
          <a href="/suche/" class="btn btn-outline">Thema suchen</a>
        </div>
      </div>

      {/* Die gelbe Flaeche: eine einzige, klar wichtigste Aktion. */}
      <a
        href="/rente/"
        class="card-accent flex flex-col justify-between gap-10 transition-colors hover:bg-[#f0cf00]"
      >
        <div>
          <p class="kicker">Meistgesucht</p>
          <p class="mt-4 text-heading font-bold leading-[1.08] tracking-[-0.027em]">
            Rente &amp; Ruhestand
          </p>
          <p class="mt-4 text-base">
            Antrag, Abschläge, Steuern und die Krankenversicherung der Rentner.
          </p>
        </div>
        <span class="btn-arrow" aria-hidden="true"><ArrowIcon /></span>
      </a>
    </div>
  </section>

  <!-- Hubs -->
  <section class="container-wide pb-20">
    <h2>Die fünf Themenbereiche</h2>
    <p class="mt-4 max-w-2xl text-lg">
      Jeder Bereich bündelt die Fragen, die in dieser Lebensphase wirklich
      gestellt werden, vom ersten Überblick bis zu den Detailfragen.
    </p>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        hubs.map((hub) => (
          <a href={`/${hub.slug}/`} class="card card-link flex min-w-0 flex-col">
            <h3>{hub.name}</h3>
            <p class="mt-3 flex-1 text-base">{hub.teaser}</p>
            <p class="mt-6 flex items-center justify-between gap-4">
              <span class="text-caption font-bold uppercase tracking-[0.08em]">
                {livePages(hub).length} Ratgeber
              </span>
              <span class="btn-arrow" aria-hidden="true">
                <ArrowIcon />
              </span>
            </p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Angebots-Slot: rendert erst, wenn ein Partnerprogramm angebunden ist -->
  <div class="container-narrow">
    <PartnerSlot topic="startseite" query="Angebote ab 50" />
  </div>

  <!-- Meistgesuchte Einstiege -->
  <section class="border-y border-ink bg-warm">
    <div class="container-wide py-20">
      <h2>Häufig gesucht</h2>
      <p class="mt-4 max-w-2xl text-lg">
        Die Fragen, die in unseren Themenbereichen am häufigsten gestellt
        werden.
      </p>
      <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          einstiege.map(({ hub, p }) => (
            <li>
              <a
                href={pageUrl(hub, p)}
                class="card card-link flex h-full min-w-0 flex-col"
              >
                <span class="kicker">{hub.name}</span>
                <span class="mt-3 block text-subheading font-bold leading-[1.2] tracking-[-0.027em]">
                  {p.nav}
                </span>
                <span class="mt-2 block text-base">{p.title}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Ratgeber-Bereich, von der Startseite aus sichtbar -->
  <section class="container-wide py-20">
    <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
      <h2>Aus dem Ratgeber</h2>
      <a
        href="/ratgeber/"
        class="text-base text-link underline decoration-link underline-offset-4"
        >Alle {allLivePages.length} Ratgeber</a
      >
    </div>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        allLivePages
          .slice()
          .sort((a, b) => b.vol * (1 + b.cpc) - a.vol * (1 + a.cpc))
          .slice(0, 8)
          .map((p) => (
            <a href={`/${p.hub}/${p.slug}/`} class="card card-link min-w-0">
              <span class="kicker">{p.hubName}</span>
              <span class="mt-3 block text-subheading font-bold leading-[1.2] tracking-[-0.027em]">
                {p.title}
              </span>
            </a>
          ))
      }
    </div>
  </section>

  <!-- Einordnung, ersetzt die uebliche Selbstlob-Sektion -->
  <section class="border-t border-ink bg-warm">
    <div class="container-wide py-20">
      <h2>Wie wir arbeiten</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-3">
        <div class="card">
          <h3>Zahlen mit Datum</h3>
          <p class="mt-3 text-base">
            Pflegegeld, Rentenwert und Zuschüsse ändern sich. Jeder Betrag steht
            hier mit Stand und Quelle, damit Sie ihn prüfen können.
          </p>
        </div>
        <div class="card">
          <h3>Keine Beratung im Einzelfall</h3>
          <p class="mt-3 text-base">
            Wir erklären Regeln und Verfahren. Ob sie auf Ihre Situation
            zutreffen, klärt Ihr Versicherungsträger oder eine Beratungsstelle.
          </p>
        </div>
        <div class="card">
          <h3>Werbung bleibt erkennbar</h3>
          <p class="mt-3 text-base">
            Wo wir Provisionen erhalten, steht es an der Stelle selbst. Der
            redaktionelle Teil wird davon nicht umsortiert.
          </p>
        </div>
      </div>
      <p class="mt-8">
        <a href="/ueber-uns/" class="btn btn-outline">Mehr über die Redaktion</a>
      </p>
    </div>
  </section>
</BaseLayout>
