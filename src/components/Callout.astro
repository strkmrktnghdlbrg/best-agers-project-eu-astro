---
/**
 * Einordnungs-Box.
 *
 * Das System kennt keine Signalfarben-Palette: es gibt genau eine Akzentfarbe,
 * und die ist der wichtigsten Aktion vorbehalten. Die Varianten unterscheiden
 * sich deshalb nicht ueber die Flaeche, sondern ueber den linken
 * Markierungsbalken und das fette Label. Gelb markiert, was man wirklich
 * lesen muss, sonst bleibt der Balken schwarz.
 */
interface Props {
  /** vorsicht = gelber Balken (muss gelesen werden), sonst schwarz */
  variant?: "evidenz" | "hinweis" | "vorsicht";
  title?: string;
}
const { variant = "hinweis", title } = Astro.props;

const bar = variant === "vorsicht" ? "border-l-yellow" : "border-l-ink";

const defaultTitle = {
  evidenz: "Was belegt ist",
  hinweis: "Zum Einordnen",
  vorsicht: "Das Wichtigste vorweg",
}[variant];
---

<aside
  class:list={[
    "my-8 rounded-lg border border-l-8 border-ink bg-warm p-5 text-ink",
    bar,
  ]}
>
  <p class="text-caption font-bold uppercase tracking-[0.08em]">
    {title ?? defaultTitle}
  </p>
  <div class="mt-3 text-base [&>p+p]:mt-3">
    <slot />
  </div>
</aside>
