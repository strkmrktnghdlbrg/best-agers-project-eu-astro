---
export type Faq = { q: string; a: string };

interface Props {
  items: Faq[];
  heading?: string;
}
const { items, heading = "Häufige Fragen" } = Astro.props;
---

{
  items.length > 0 && (
    <section class="mt-12">
      <h2 class="font-display text-2xl font-bold text-ink-900">{heading}</h2>
      <div class="mt-5 flex flex-col gap-3">
        {items.map((item) => (
          <details class="group rounded-xl border border-ink-200 bg-white px-5 py-4">
            <summary class="cursor-pointer list-none font-display text-base font-bold text-ink-900 marker:content-none">
              <span class="flex items-start justify-between gap-3">
                {item.q}
                <span
                  class="mt-1 shrink-0 text-azure-500 transition-transform group-open:rotate-45"
                  aria-hidden="true"
                >
                  +
                </span>
              </span>
            </summary>
            <p class="mt-3 text-[0.95rem] leading-relaxed text-ink-600">
              {item.a}
            </p>
          </details>
        ))}
      </div>
    </section>
  )
}
