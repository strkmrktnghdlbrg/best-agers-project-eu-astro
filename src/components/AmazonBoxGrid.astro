---
import { site } from "../data/site";
import groups from "../data/amazon-groups.json";
import products from "../data/amazon-products.json";

/**
 * Produktkarten aus der Amazon Creators API.
 *
 * Datenfluss: `npm run creators` -> amazon-groups.json (ASINs je Gruppe) +
 * amazon-products.json (Produktdaten je ASIN). Hier wird nur gerendert.
 *
 * Fallback: Gibt es fuer die Gruppe keine ASINs (oder keinen Eintrag), wird der
 * getaggte Suchlink gerendert. Damit funktioniert jede Seite, auch die, fuer die
 * bewusst keine Produktgruppe existiert (Methoden, Schwermetalle, Leber).
 *
 * Die hrefs zeigen direkt auf amazon.de – das Outbound-Gate rewritet sie beim
 * Build auf /go/?u=. Kein eigener dataLayer-Push, der Gate-Listener macht das.
 */
type Product = {
  asin: string;
  title: string;
  brand: string;
  url: string;
  image: string;
  price: string;
  features: string[];
};

interface Props {
  /** Gruppenschluessel: "<silo>" oder "<silo>/<pageSlug>". */
  topic: string;
  /** Suchbegriff fuer den Fallback. */
  query: string;
  max?: number;
}
const { topic, query, max = 4 } = Astro.props;

const group = (groups as Record<string, { title?: string; asins?: string[] }>)[topic];
const all = products as Record<string, Product>;
const items = (group?.asins ?? [])
  .map((a) => all[a])
  .filter((p): p is Product => Boolean(p && p.title && p.image))
  .slice(0, max);

const searchUrl = `${site.amazonHost}/s?k=${encodeURIComponent(query)}&tag=${site.amazonTag}`;
---

{
  items.length > 0 ? (
    <ul class="mt-4 grid gap-3 sm:grid-cols-2">
      {items.map((p) => (
        <li class="min-w-0">
          <a
            href={p.url}
            rel="sponsored nofollow noopener"
            target="_blank"
            class="group flex h-full gap-3 rounded-lg border border-ink bg-white p-3 transition-all hover:border-ink hover:shadow-lg hover:"
          >
            <img
              src={p.image}
              alt=""
              width="72"
              height="72"
              loading="lazy"
              decoding="async"
              class="h-18 w-18 shrink-0 rounded-lg object-contain"
              style="width:4.5rem;height:4.5rem"
            />
            <span class="flex min-w-0 flex-col">
              {p.brand && (
                <span class="text-xs font-bold uppercase tracking-wide text-link">
                  {p.brand}
                </span>
              )}
              <span class="mt-0.5 line-clamp-3 text-sm font-bold leading-snug text-ink group-hover:text-link">
                {p.title}
              </span>
              {p.price && (
                <span class="mt-auto pt-1.5 font-display text-base font-bold text-ink">
                  {p.price}
                </span>
              )}
            </span>
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <ul class="mt-4 flex flex-wrap gap-2">
      <li>
        <a
          href={searchUrl}
          rel="sponsored nofollow noopener"
          target="_blank"
          class="btn btn-outline text-[0.9rem]"
        >
          {query} bei Amazon ansehen
          <span aria-hidden="true">→</span>
        </a>
      </li>
    </ul>
  )
}

{
  items.length > 0 && (
    <p class="mt-3 text-xs leading-relaxed text-ink">
      Preise und Verfügbarkeit können sich geändert haben; maßgeblich ist der
      Stand auf der Amazon-Produktseite. Die Produkttitel stammen von den
      Herstellern – sie sind keine Aussage dieser Seite über eine Wirkung.
    </p>
  )
}
