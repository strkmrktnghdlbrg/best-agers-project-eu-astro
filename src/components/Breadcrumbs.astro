---
interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---

<nav aria-label="Brotkrumen" class="text-sm">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-ink-400">
    <li><a href="/" class="hover:text-azure-700">Start</a></li>
    {
      items.map((item) => (
        <>
          <li aria-hidden="true" class="text-ink-300">/</li>
          <li>
            {item.href ? (
              <a href={item.href} class="hover:text-azure-700">
                {item.label}
              </a>
            ) : (
              <span class="text-ink-600">{item.label}</span>
            )}
          </li>
        </>
      ))
    }
  </ol>
</nav>
