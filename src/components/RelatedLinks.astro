---
import {
  relatedHubs,
  hubUrl,
  pageUrl,
  livePages,
  type Hub,
  type HubPage,
} from "../data/taxonomy";

interface Props {
  hub: Hub;
  /** Aktuelle Unterseite – wird aus der Geschwisterliste ausgeblendet. */
  current?: HubPage;
}
const { hub, current } = Astro.props;

const siblings = livePages(hub)
  .filter((p) => p.slug !== current?.slug)
  .slice(0, 6);
const related = relatedHubs(hub.slug);
---

<div class="mt-14 grid gap-6 border-t border-ink-200 pt-10 md:grid-cols-2">
  {
    siblings.length > 0 && (
      <section class="min-w-0">
        <h2 class="font-display text-lg font-bold text-ink-900">
          Weiter zu {hub.name}
        </h2>
        <ul class="mt-3 flex flex-col gap-2">
          {siblings.map((p) => (
            <li>
              <a
                href={pageUrl(hub, p)}
                class="text-[0.95rem] text-azure-700 underline decoration-azure-200 underline-offset-4 transition-colors hover:decoration-azure-500"
              >
                {p.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    related.length > 0 && (
      <section class="min-w-0">
        <h2 class="font-display text-lg font-bold text-ink-900">
          Verwandte Themen
        </h2>
        <ul class="mt-3 flex flex-col gap-2">
          {related.map((h) => (
            <li>
              <a
                href={hubUrl(h)}
                class="text-[0.95rem] text-azure-700 underline decoration-azure-200 underline-offset-4 transition-colors hover:decoration-azure-500"
              >
                {h.name}
              </a>
              <span class="text-sm text-ink-400"> – {h.teaser}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</div>
