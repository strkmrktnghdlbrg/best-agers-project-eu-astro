---
import { site } from "../data/site";
import { hubs, livePages } from "../data/taxonomy";

const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-ink-200 bg-ink-50">
  <div class="container-wide py-14">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-3">
      <div class="min-w-0 lg:col-span-1">
        <span class="font-display text-xl font-bold text-azure-700"
          >Best Agers</span
        >
        <p class="mt-3 text-sm leading-relaxed text-ink-500">
          {site.description}
        </p>
        <ul class="mt-4 flex flex-col gap-1.5">
          <li>
            <a
              href="/ratgeber/"
              class="text-sm text-ink-500 transition-colors hover:text-azure-700"
              >Alle Ratgeber</a
            >
          </li>
          <li>
            <a
              href="/suche/"
              class="text-sm text-ink-500 transition-colors hover:text-azure-700"
              >Suche</a
            >
          </li>
        </ul>
      </div>

      <div class="grid gap-10 sm:grid-cols-2 lg:col-span-2 lg:grid-cols-3">
        {
          hubs.map((hub) => (
            <div class="min-w-0">
              <h2 class="font-display text-sm font-bold uppercase tracking-wide text-ink-900">
                <a href={`/${hub.slug}/`} class="hover:text-azure-700">
                  {hub.name}
                </a>
              </h2>
              <ul class="mt-3 flex flex-col gap-1.5">
                {livePages(hub)
                  .slice(0, 6)
                  .map((p) => (
                    <li>
                      <a
                        href={`/${hub.slug}/${p.slug}/`}
                        class="text-sm text-ink-500 transition-colors hover:text-azure-700"
                      >
                        {p.nav}
                      </a>
                    </li>
                  ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div
      class="mt-12 rounded-xl border border-warn-200 bg-warn-50 p-4 text-xs leading-relaxed text-warn-700"
    >
      <strong class="font-semibold">Hinweis:</strong> Die Inhalte dieser Seite dienen
      der allgemeinen Information. Sie ersetzen keine ärztliche, rechtliche, steuerliche
      oder finanzielle Beratung im Einzelfall. Beträge und Fristen aus dem Sozialrecht
      ändern sich regelmäßig, maßgeblich ist immer die Auskunft Ihres Versicherungsträgers.
    </div>

    <div
      class="mt-8 flex flex-col gap-4 border-t border-ink-200 pt-6 text-sm text-ink-400 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {site.domain}</p>
      <nav aria-label="Rechtliches">
        <ul class="flex flex-wrap gap-x-5 gap-y-2">
          <li><a href="/ueber-uns/" class="hover:text-azure-700">Über uns</a></li>
          <li><a href="/kontakt/" class="hover:text-azure-700">Kontakt</a></li>
          <li><a href="/impressum/" class="hover:text-azure-700">Impressum</a></li>
          <li>
            <a href="/datenschutz/" class="hover:text-azure-700">Datenschutz</a>
          </li>
        </ul>
      </nav>
    </div>
  </div>
</footer>
