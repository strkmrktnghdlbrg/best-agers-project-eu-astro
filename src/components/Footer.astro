---
import { site } from "../data/site";
import { hubs, livePages } from "../data/taxonomy";

const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-ink bg-warm">
  <div class="container-wide py-14">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-3">
      <div class="min-w-0 lg:col-span-1">
        <span class="inline-block rounded-lg border border-ink bg-yellow px-3 py-1.5 text-xl font-bold tracking-[-0.027em] text-ink"
          >Best Agers</span
        >
        <p class="mt-3 text-sm leading-relaxed text-ink">
          {site.description}
        </p>
        <ul class="mt-4 flex flex-col gap-1.5">
          <li>
            <a
              href="/ratgeber/"
              class="text-sm text-ink transition-colors hover:text-link"
              >Alle Ratgeber</a
            >
          </li>
          <li>
            <a
              href="/suche/"
              class="text-sm text-ink transition-colors hover:text-link"
              >Suche</a
            >
          </li>
        </ul>
      </div>

      <div class="grid gap-10 sm:grid-cols-2 lg:col-span-2 lg:grid-cols-3">
        {
          hubs.map((hub) => (
            <div class="min-w-0">
              <h2 class="font-display text-sm font-bold uppercase tracking-wide text-ink">
                <a href={`/${hub.slug}/`} class="hover:text-link">
                  {hub.name}
                </a>
              </h2>
              <ul class="mt-3 flex flex-col gap-1.5">
                {livePages(hub)
                  .slice(0, 6)
                  .map((p) => (
                    <li>
                      <a
                        href={`/${hub.slug}/${p.slug}/`}
                        class="text-sm text-ink transition-colors hover:text-link"
                      >
                        {p.nav}
                      </a>
                    </li>
                  ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div
      class="mt-12 rounded-lg border border-ink bg-warm p-4 text-xs leading-relaxed text-ink"
    >
      <strong class="font-bold">Hinweis:</strong> Die Inhalte dieser Seite dienen
      der allgemeinen Information. Sie ersetzen keine ärztliche, rechtliche, steuerliche
      oder finanzielle Beratung im Einzelfall. Beträge und Fristen aus dem Sozialrecht
      ändern sich regelmäßig, maßgeblich ist immer die Auskunft Ihres Versicherungsträgers.
    </div>

    <div
      class="mt-8 flex flex-col gap-4 border-t border-ink pt-6 text-sm text-ink sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {site.domain}</p>
      <nav aria-label="Rechtliches">
        <ul class="flex flex-wrap gap-x-5 gap-y-2">
          <li><a href="/ueber-uns/" class="hover:text-link">Über uns</a></li>
          <li><a href="/kontakt/" class="hover:text-link">Kontakt</a></li>
          <li>
            <a href="/bildnachweis/" class="hover:text-link">Bildnachweis</a>
          </li>
          <li><a href="/impressum/" class="hover:text-link">Impressum</a></li>
          <li>
            <a href="/datenschutz/" class="hover:text-link">Datenschutz</a>
          </li>
        </ul>
      </nav>
    </div>
  </div>
</footer>
